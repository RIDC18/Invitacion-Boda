{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".vexp/**",
      ".codex/**",
      ".firebase/**",
      "**/node_modules/**",
      "checkpoints/**",
      "img_originals/**",
      "code.gs",
      "firebase-debug.log",
      "*.zip",
      "*.md",
      "package.json",
      "package-lock.json",
      "scripts/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|mp3|ogg|wav)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      }
    ]
  }
}
